# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Data Directory Configuration
# 默认：开发环境使用 {project_root}/data/，生产环境使用 ~/.repsclaw/data/
# 如需自定义数据存储路径，取消下面注释并设置路径：
# REPSCLAW_DATA_DIR=/path/to/custom/data

# 数据目录结构：
# ${REPSCLAW_DATA_DIR}/
# ├── hospitals/          # 医院订阅数据 (Markdown)
# ├── doctors/            # 医生订阅数据 (Markdown)
# ├── news/               # 新闻缓存数据 (Markdown，按日期组织)
# ├── cache/              # 临时缓存数据
# │   ├── wechat/         # WeChat 搜索缓存
# │   └── search/         # 其他搜索缓存
# └── storage/            # Crawlee 存储目录

# OpenClaw Configuration
OPENCLAW_PLUGIN_PATH=./plugins

# Vector Database (Milvus/Pinecone)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# External APIs
PUBMED_API_KEY=
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

CNKI_API_KEY=
CNKI_BASE_URL=

FDA_API_KEY=
FDA_BASE_URL=https://api.fda.gov/drug

CLINICAL_TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

MEDICAL_TERMINOLOGY_BASE_URL=https://clinicaltables.nlm.nih.gov/api/icd10cm/v3

MEDRXIV_BASE_URL=https://api.medrxiv.org

NCBI_BOOKSHELF_API_KEY=
NCBI_BOOKSHELF_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Logging
LOG_LEVEL=info

# ========== Test Configuration ==========
# HTTP Real Environment Test Mode
# local    - Requires local OpenClaw + Markdown storage environment (uses persistent storage)
# virtual  - Standalone test server with in-memory storage (no Markdown/OpenClaw required)
REPSCLAW_TEST_MODE=virtual

# Test Server Configuration (for virtual mode)
REPSCLAW_TEST_PORT=3001
REPSCLAW_TEST_HOST=127.0.0.1

# Test Target URL (for local mode, or override virtual mode)
REPSCLAW_TEST_URL=http://localhost:3001

# ========== Deployment Configuration ==========
# Deploy mode: local or remote
# local  - Deploy to local OpenClaw plugin directory
# remote - Deploy to remote server via SSH
DEPLOY_MODE=remote

# Local deployment config (optional, default: ~/.openclaw/extensions/repsclaw)
LOCAL_PLUGIN_DIR=~/.openclaw/extensions/repsclaw

# Remote deployment config
DEPLOY_TARGET_IP=192.168.64.5
DEPLOY_SSH_USER=tony203

# SSH auth: key file path OR password (sshpass required for password)
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_SSH_PASSWORD=your_password_here

# Remote plugin directory (auto-discovered and saved by deploy.sh)
# Leave empty to auto-discover, or set manually if known
REMOTE_PLUGIN_DIR=
